# ============================================================
# 投资信号蒸馏台 — 环境变量配置模板
# ============================================================
# 使用方法:
#   1. cp config/.env.example .env
#   2. 编辑 .env 填入实际值
#   3. docker compose up
#
# 生成密钥:
#   Python: python -c "import secrets; print(secrets.token_hex(32))"
#   Shell:  openssl rand -hex 32
# ============================================================

# ── 必填（生产部署前必须设置）────────────────────────────
# JWT Token 密钥 — 用于用户登录令牌签名
# 生成: openssl rand -hex 32
JWT_SECRET_KEY=

# 用户配置加密密钥 — Fernet AES-128-CBC
# 生成: openssl rand -hex 32
ENCRYPTION_KEY=

# 管理后台登录密码 — 至少 12 位字母数字混合
ADMIN_PASSWORD=

# 可选: Dashboard 访问令牌
# DASHBOARD_TOKEN=

# ── 数据库 ──────────────────────────────────────────────
# 开发用 SQLite（默认）
DATABASE_URL=sqlite:///./data/twitter_data.db
# 生产推荐 PostgreSQL（需取消 docker-compose.prod.yml 注释）:
# DATABASE_URL=postgresql://distiller:密码@postgres:5432/twitter_distiller

# ── LLM / AI（功能必需）────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
# 可选: 其他兼容 API
# LLM_BASE_URL=https://api.openai.com/v1
# FILTER_MODEL=gpt-4o-mini
# ANALYZER_MODEL=gpt-4o

# ── Telegram Bot（推送必需）────────────────────────────
# 1. 在 @BotFather 创建 Bot，获取 Token
# 2. 获取你的 Chat ID（向 bot 发消息后访问 https://api.telegram.org/bot<TOKEN>/getUpdates）
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# ── Twitter 爬虫（必需）────────────────────────────────
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# ── 备选爬虫 ────────────────────────────────────────────
# APIFY_API_TOKEN=

# ── 可选 ────────────────────────────────────────────────
# VECTOR_DB_PATH=./data/vector_db
# EMBEDDING_MODEL=text-embedding-3-small
# LOG_LEVEL=INFO
# LOG_PATH=./logs
# CRAWL_INTERVAL_HOURS=6
# MAX_TWEETS_PER_USER=1000
# DOWNLOAD_MEDIA=true
# NITTER_BASE_URL=https://nitter.net
# CORS_ORIGINS=http://localhost:8080
# ENV=development
